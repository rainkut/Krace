func _cars() -> void:
	var by_model := {}
	for c in d["cars"]:
		var m := str(c[3])
		if not by_model.has(m):
			by_model[m] = []
		var xf := transform * Transform3D(Basis(Vector3.UP, float(c[2]) + PI).scaled(Vector3.ONE * 1.75), P(float(c[0]), 0.575, float(c[1])))
		(by_model[m] as Array).append(xf)
		_coll(float(c[0]), 0.7, float(c[1]), 2.3, 1.4, 4.4, float(c[2]))
	for m in by_model:
		w._scatter("res://assets/kenney/cars/%s.glb" % m, by_model[m])

func _hills() -> void:
	for h in d["hills"]:
		var hu := float(h["u"]); var hv := float(h["v"]); var hw := float(h["w"]); var hh := float(h["h"])
		var ridge: bool = h["kind"] == "ridge"
		var st := SurfaceTool.new(); st.begin(Mesh.PRIMITIVE_TRIANGLES)
		var steps := 36
		var dep := 90.0 if ridge else hw * 0.45
		for k in steps:
			var t0 := float(k) / steps
			var t1 := float(k + 1) / steps
			var rows: Array = []
			for tt: float in [t0, t1]:
				var x := (tt - 0.5) * hw
				var prof := (1.0 - pow(absf(tt - 0.5) * 2.0, 2.0)) if not ridge else (0.55 + 0.45 * sin(tt * 17.0) * sin(tt * 5.3 + 1.0))
				rows.append([x, maxf(prof, 0.0) * hh])
			var a: Array = rows[0]
			var b: Array = rows[1]
			var q := [Vector3(a[0], 0, 0), Vector3(b[0], 0, 0), Vector3(b[0] * 0.6, b[1], -dep * 0.45), Vector3(a[0] * 0.6, a[1], -dep * 0.45)]
			var q2 := [Vector3(a[0] * 0.6, a[1], -dep * 0.45), Vector3(b[0] * 0.6, b[1], -dep * 0.45), Vector3(b[0] * 0.8, 0, -dep), Vector3(a[0] * 0.8, 0, -dep)]
			for qq in [q, q2]:
				for idx in [0, 1, 2, 0, 2, 3]:
					st.set_normal(Vector3.UP)
					st.set_color(Color("8d8a82").lerp(Color("a9b5c0"), 0.35))
					st.add_vertex(qq[idx])
		var mesh := st.commit()
		var mi := MeshInstance3D.new()
		mi.mesh = mesh
		mi.material_override = _mat_solid
		mi.position = P(hu, -1.0, hv)
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		add_child(mi)
