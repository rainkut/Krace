extends Node
## Placeholder audio: raw PCM generated by tools/gen_audio.py, built into AudioStreamWAV at runtime.

const NAMES := ["engine", "nitro", "hit", "swing", "crash", "bump", "pickup", "beep", "go", "click", "overtake", "nearmiss", "music"]
var streams := {}
var pool: Array[AudioStreamPlayer] = []
var engine_p: AudioStreamPlayer
var nitro_p: AudioStreamPlayer
var music_p: AudioStreamPlayer
var music_on := false

func _ready() -> void:
	for n in NAMES:
		var bytes := FileAccess.get_file_as_bytes("res://assets/audio/%s.pcm" % n)
		if bytes.is_empty():
			continue
		var w := AudioStreamWAV.new()
		w.format = AudioStreamWAV.FORMAT_16_BITS
		w.mix_rate = 22050
		w.stereo = false
		w.data = bytes
		if n in ["engine", "nitro", "music"]:
			w.loop_mode = AudioStreamWAV.LOOP_FORWARD
			w.loop_begin = 0
			w.loop_end = bytes.size() / 2
		streams[n] = w
	for i in 10:
		var p := AudioStreamPlayer.new()
		add_child(p)
		pool.append(p)
	engine_p = _loop("engine")
	nitro_p = _loop("nitro")
	music_p = _loop("music")

func _loop(n: String) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.stream = streams.get(n)
	add_child(p)
	return p

func sfx_vol() -> float:
	return float(Save.setting("sfx"))

func play(n: String, vol := 1.0, pitch := 1.0) -> void:
	if not streams.has(n):
		return
	for p in pool:
		if not p.playing:
			p.stream = streams[n]
			p.volume_db = linear_to_db(maxf(0.001, vol * sfx_vol()))
			p.pitch_scale = pitch
			p.play()
			return

func engine(on: bool, speed01 := 0.0, boost := false) -> void:
	if engine_p.stream == null:
		return
	if on and not engine_p.playing:
		engine_p.play()
	elif not on and engine_p.playing:
		engine_p.stop()
	engine_p.pitch_scale = 0.7 + speed01 * 2.2
	engine_p.volume_db = linear_to_db(maxf(0.001, 0.35 * sfx_vol()))
	var nit_on := on and boost
	if nit_on and not nitro_p.playing:
		nitro_p.play()
	elif not nit_on and nitro_p.playing:
		nitro_p.stop()
	nitro_p.volume_db = linear_to_db(maxf(0.001, 0.3 * sfx_vol()))

func music(on: bool) -> void:
	music_on = on
	if music_p.stream == null:
		return
	music_p.volume_db = linear_to_db(maxf(0.001, 0.45 * float(Save.setting("music"))))
	if on and not music_p.playing:
		music_p.play()
	elif not on and music_p.playing:
		music_p.stop()

func refresh_volume() -> void:
	music(music_on)
