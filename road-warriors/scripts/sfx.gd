extends Node
## Placeholder audio: raw PCM generated by tools/gen_audio.py, built into AudioStreamWAV at runtime.

const NAMES := ["engine", "nitro", "hit", "swing", "crash", "bump", "pickup", "beep", "go", "click", "overtake", "nearmiss", "music", "music_night", "music_cruise", "wind", "rain", "shift", "scrape", "screech", "whoosh", "thud", "stinger", "impact"]
var streams := {}
var pool: Array[AudioStreamPlayer] = []
var engine_p: AudioStreamPlayer
var nitro_p: AudioStreamPlayer
var music_p: AudioStreamPlayer
var music_on := false
var wind_p: AudioStreamPlayer
var rain_p: AudioStreamPlayer
var gear := 0
var shift_cd := 0.0
var scrape_cd := 0.0
var reverb: AudioEffectReverb
const GEARS := [0.0, 0.2, 0.38, 0.56, 0.76]

func _ready() -> void:
	for n in NAMES:
		var bytes := FileAccess.get_file_as_bytes("res://assets/audio/%s.pcm" % n)
		if bytes.is_empty():
			continue
		var w := AudioStreamWAV.new()
		w.format = AudioStreamWAV.FORMAT_16_BITS
		w.mix_rate = 22050
		w.stereo = false
		w.data = bytes
		if n in ["engine", "nitro", "music", "music_night", "wind", "rain"]:
			w.loop_mode = AudioStreamWAV.LOOP_FORWARD
			w.loop_begin = 0
			w.loop_end = bytes.size() / 2
		streams[n] = w
	for i in 10:
		var p := AudioStreamPlayer.new()
		add_child(p)
		pool.append(p)
	engine_p = _loop("engine")
	nitro_p = _loop("nitro")
	music_p = _loop("music")
	wind_p = _loop("wind")
	rain_p = _loop("rain")
	AudioServer.add_bus()
	var bi := AudioServer.bus_count - 1
	AudioServer.set_bus_name(bi, "Env")
	AudioServer.set_bus_send(bi, "Master")
	reverb = AudioEffectReverb.new()
	reverb.room_size = 0.85
	reverb.wet = 0.0
	reverb.dry = 1.0
	AudioServer.add_bus_effect(bi, reverb)
	for p in [engine_p, nitro_p, wind_p, rain_p]:
		p.bus = "Env"
	for p in pool:
		p.bus = "Env"

func _loop(n: String) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.stream = streams.get(n)
	add_child(p)
	return p

func amb_vol() -> float:
	return float(Save.setting("amb"))

func sfx_vol() -> float:
	return float(Save.setting("sfx"))

func play(n: String, vol := 1.0, pitch := 1.0) -> void:
	if not streams.has(n):
		return
	for p in pool:
		if not p.playing:
			p.stream = streams[n]
			p.volume_db = linear_to_db(maxf(0.001, vol * sfx_vol()))
			p.pitch_scale = pitch
			p.play()
			return

func engine(on: bool, speed01 := 0.0, boost := false) -> void:
	if engine_p.stream == null:
		return
	if on and not engine_p.playing:
		engine_p.play()
	elif not on and engine_p.playing:
		engine_p.stop()
	var g := 0
	for i in GEARS.size():
		if speed01 >= GEARS[i]:
			g = i
	var hi: float = GEARS[g + 1] if g + 1 < GEARS.size() else 1.0
	var frac := clampf((speed01 - GEARS[g]) / maxf(0.01, hi - GEARS[g]), 0.0, 1.0)
	var dt := get_process_delta_time()
	shift_cd = maxf(0.0, shift_cd - dt)
	if on and g != gear and shift_cd <= 0.0:
		if g > gear:
			play("shift", 0.35, 1.0 + g * 0.05)
		shift_cd = 0.4
	gear = g
	engine_p.pitch_scale = 0.8 + frac * 1.1 + (0.0 if boost else 0.0)
	var wv := clampf(speed01 * speed01 * 1.1, 0.0, 1.0) if on else 0.0
	if wind_p.stream != null:
		if on and not wind_p.playing:
			wind_p.play()
		elif not on and wind_p.playing:
			wind_p.stop()
		wind_p.volume_db = linear_to_db(maxf(0.001, 0.5 * wv * sfx_vol() * amb_vol()))
		wind_p.pitch_scale = 0.8 + speed01 * 0.6
	engine_p.volume_db = linear_to_db(maxf(0.001, 0.35 * sfx_vol() * amb_vol()))
	var nit_on := on and boost
	if nit_on and not nitro_p.playing:
		nitro_p.play()
	elif not nit_on and nitro_p.playing:
		nitro_p.stop()
	nitro_p.volume_db = linear_to_db(maxf(0.001, 0.3 * sfx_vol()))

func music(on: bool, track := "music") -> void:
	music_on = on
	if streams.has(track) and music_p.stream != streams[track]:
		var was := music_p.playing
		music_p.stop()
		music_p.stream = streams[track]
		if was:
			music_p.play()
	if music_p.stream == null:
		return
	music_p.volume_db = linear_to_db(maxf(0.001, 0.45 * float(Save.setting("music"))))
	if on and not music_p.playing:
		music_p.play()
	elif not on and music_p.playing:
		music_p.stop()

func refresh_volume() -> void:
	music(music_on)

func rain(on: bool) -> void:
	if rain_p.stream == null:
		return
	if on and not rain_p.playing:
		rain_p.play()
	elif not on and rain_p.playing:
		rain_p.stop()
	rain_p.volume_db = linear_to_db(maxf(0.001, 0.22 * sfx_vol() * amb_vol()))

func tunnel(on: bool) -> void:
	if reverb != null:
		reverb.wet = lerpf(reverb.wet, 0.45 if on else 0.0, 0.1)

func scrape_snd(on: bool) -> void:
	scrape_cd = maxf(0.0, scrape_cd - get_process_delta_time())
	if on and scrape_cd <= 0.0:
		play("scrape", 0.5, randf_range(0.9, 1.1))
		scrape_cd = 0.45
